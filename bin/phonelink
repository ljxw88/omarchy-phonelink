#!/bin/bash

# phonelink: use your Android phone from Omarchy, on top of scrcpy.
#
#   phonelink              Open the Phone menu
#   phonelink apps         Pick a phone app and open it in its own window
#   phonelink open <pkg>   Open one phone app in its own window
#   phonelink mirror       Mirror and control the whole phone screen
#   phonelink pin          Choose which phone apps appear in the app launcher
#   phonelink pair         Pair over Wi-Fi with a QR code (Android 11+)
#   phonelink connect      Connect to a paired phone, nearby or over Tailscale
#   phonelink connect <port>  Reach the phone over Tailscale at this Wireless debugging port
#   phonelink sound [pc|phone|toggle] [mirror|<pkg>]
#                          Play a phone window's sound on this computer or the phone
#   phonelink direct       Link straight to the phone with Wi-Fi Direct (faster)
#   phonelink direct off   Drop the direct link
#   phonelink wifi         Switch a USB-connected phone to Wi-Fi
#   phonelink stop         Close phone windows and drop all connections
#   phonelink refresh      Re-read the app list from the phone
#   phonelink status       Show connected phones
#   phonelink doctor       Check for common causes of lag and dropouts
#
# Each phone app runs on its own virtual display that resizes with its window,
# so it tiles like a desktop app and leaves the phone's own screen alone.
#
# Over Wi-Fi, video normally travels phone → router → laptop. When the phone is
# only on Wi-Fi, phonelink sets up a Wi-Fi Direct link (the kind Smart View
# uses) straight between the two, while both stay on the home network.
#
# Away from home, phonelink reaches the phone over Tailscale when both are on
# the same tailnet.
#
# Each window runs as a session that watches its connection: it lowers the
# video quality when the link falls behind, and reconnects when the link
# drops, freezes, or a better one turns up.
#
# https://github.com/ljxw88/omarchy-phonelink

set -uo pipefail

SELF=$(readlink -f "$0")
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/phonelink/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/phonelink"
LOG_DIR="$STATE_DIR/logs"
APPS_CACHE="$STATE_DIR/apps.tsv"
RECENT_FILE="$STATE_DIR/recent"
TCP_FILE="$STATE_DIR/last-tcp"
DIRECT_FILE="$STATE_DIR/direct-addr"
DIRECT_PEER_FILE="$STATE_DIR/direct-peer"
DIRECT_FAIL_FILE="$STATE_DIR/direct-failed"
DIRECT_CON="phonelink-direct"
TAILNET_FILE="$STATE_DIR/tailnet"
QUALITY_FILE="$STATE_DIR/quality"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"
ICON_DIR="$ICON_ROOT/256x256/apps"

# Defaults. Override any of them in ~/.config/phonelink/config.
SERIAL=""                          # pin one phone when several are connected
DIRECT="auto"                      # auto = use a Wi-Fi Direct link when on Wi-Fi, off = always via the router
APP_ICONS="play"                   # play = app icons from Google Play (sends it the app's package name), off = a generic icon
KEYBOARD="uhid"                    # uhid = real keyboard on the phone, sdk = injected text
APP_DPI=200                        # app window density; higher makes the app UI bigger
SOUND="pc"                         # where a phone window's sound plays until you switch it: pc or phone
APP_ARGS=(--no-vd-system-decorations --keep-active)
MIRROR_ARGS=(--max-size=1600)
COMMON_ARGS=()                     # extra scrcpy options for every window; they override the automatic quality
TAILSCALE="auto"                   # auto = reach the phone over Tailscale when it isn't nearby, off = never
TAILSCALE_HOST=""                  # the phone's Tailscale name or address, if phonelink can't work it out
REMOTE_ARGS=()                     # extra scrcpy options over Tailscale
ADAPT="auto"                       # auto = fit the video quality to the connection, off = scrcpy's defaults plus your options
RECONNECT_SECS=120                 # how long a dropped window keeps trying to come back; 0 = close it instead

# shellcheck source=/dev/null
[[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE"

mkdir -p "$STATE_DIR" "$LOG_DIR"

# ---------------------------------------------------------------- helpers

notify() {
  omarchy-notification-send --app-name phonelink -g 󰄜 "$@" &>/dev/null ||
    notify-send -a phonelink "$@" &>/dev/null || true
}

die() {
  echo "phonelink: $*" >&2
  [[ -n ${PHONELINK_QUIET:-} ]] || notify -u normal "Phone" "$*"
  exit 1
}

valid_pkg() {
  [[ $1 =~ ^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)+$ ]]
}

require_tools() {
  command -v scrcpy &>/dev/null && command -v adb &>/dev/null ||
    die "scrcpy is missing. Install it with: omarchy pkg add scrcpy android-tools"
}

app_name() {
  local name
  name=$(awk -F'\t' -v p="$1" '$2 == p { print $1; exit }' "$APPS_CACHE" 2>/dev/null)
  if [[ -z $name ]]; then
    name=$(sed -n 's/^Name=\(.*\) (Phone)$/\1/p' "$DESKTOP_DIR/phonelink.$1.desktop" 2>/dev/null | head -1)
  fi
  printf '%s' "${name:-$1}"
}

focus_class() {
  local address
  address=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$1" 'first(.[] | select(.class == $c) | .address) // empty')
  [[ -n $address ]] || return 1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" &>/dev/null ||
    hyprctl dispatch focuswindow "address:$address" &>/dev/null
}

# Prints "pid<TAB>id" for every scrcpy phonelink started: the mirror
# ("phonelink"), app windows ("phonelink.<package>") and the sound connection.
phonelink_processes() {
  local pid id
  for pid in $(pgrep -x scrcpy); do
    id=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^SDL_APP_ID=//p')
    [[ $id == phonelink* ]] && printf '%s\t%s\n' "$pid" "$id"
  done
  return 0
}

# The current Omarchy theme's background, so bars around the phone picture
# blend in like a terminal's.
theme_background() {
  local colors="$HOME/.local/state/omarchy/current/theme/colors.toml" color
  color=$(sed -nE 's/^background *= *"#?([0-9A-Fa-f]{6})".*/\1/p' "$colors" 2>/dev/null | head -1)
  printf '%s' "${color:-1a1b26}"
}

# Options shared by every phone window. Super carries scrcpy's own shortcuts,
# as it does Omarchy's, so Alt reaches the phone's apps.
window_args() {
  printf '%s\n' --background-color="$(theme_background)" --shortcut-mod=lsuper --keyboard="$KEYBOARD"
}

# Logical size of the tile a new window gets in Hyprland's dwindle layout: the
# whole workspace when it's empty, otherwise half of the focused window.
# Starting the phone app at that size spares it a relayout once it's tiled.
tile_size() {
  local w h
  read -r w h < <(hyprctl activewindow -j 2>/dev/null |
    jq -r 'select(.size and .floating == false and .fullscreen == 0) | "\(.size[0]) \(.size[1])"' 2>/dev/null)
  if [[ -n ${w:-} ]]; then
    if ((w > h)); then w=$((w / 2)); else h=$((h / 2)); fi
  else
    read -r w h < <(hyprctl monitors -j 2>/dev/null |
      jq -r '.[] | select(.focused) | "\((.width / .scale) | floor) \((.height / .scale) | floor)"')
  fi
  [[ -n ${w:-} && -n ${h:-} ]] || return 1
  printf '%dx%d' $((w / 2 * 2)) $((h / 2 * 2))
}

# ---------------------------------------------------------------- devices

# adb, without phonelink's lock files. When its server isn't running, adb
# starts one in the background, and that server would hold any lock it
# inherited for as long as it runs: a window could never open again, or the
# sound never come back. LAUNCH_LOCK, SOUND_LOCK and SESSION_LOCK are set
# while held.
adb() {
  if [[ -z ${LAUNCH_LOCK:-}${SOUND_LOCK:-}${SESSION_LOCK:-} ]]; then
    command adb "$@"
    return
  fi
  (
    [[ -n ${LAUNCH_LOCK:-} ]] && exec {LAUNCH_LOCK}>&-
    [[ -n ${SOUND_LOCK:-} ]] && exec {SOUND_LOCK}>&-
    [[ -n ${SESSION_LOCK:-} ]] && exec {SESSION_LOCK}>&-
    exec adb "$@"
  )
}

# adb with a time limit, the same way.
adb_timed() {
  local secs=$1
  shift
  (
    [[ -n ${LAUNCH_LOCK:-} ]] && exec {LAUNCH_LOCK}>&-
    [[ -n ${SOUND_LOCK:-} ]] && exec {SOUND_LOCK}>&-
    [[ -n ${SESSION_LOCK:-} ]] && exec {SESSION_LOCK}>&-
    exec timeout "$secs" adb "$@"
  )
}

# Every device adb knows, emulators included.
all_devices() {
  adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1 }'
}

# Phones only. Emulators belong to Android Studio, and one listed without an
# address would otherwise pass for a phone on USB.
ready_devices() {
  all_devices | grep -v '^emulator-' || true
}

# Devices on USB have neither an address nor an mDNS name.
usb_devices() {
  grep -vE ':|_adb-tls-connect' || true
}

connect_wireless() {
  local addr
  # Phones with Wireless debugging on announce themselves over mDNS.
  while read -r addr; do
    [[ -n $addr ]] && adb_timed 4 connect "$addr" &>/dev/null
  done < <(adb mdns services 2>/dev/null | awk '/_adb-tls-connect/ { print $NF }')

  # Phones switched to Wi-Fi with `phonelink wifi`.
  [[ -s $TCP_FILE ]] && adb_timed 4 connect "$(<"$TCP_FILE")" &>/dev/null
  sleep 0.5
}

# Phones reachable nearby: on USB, over the direct link while it's up, or
# through the router. A direct link that dropped can stay listed for a while.
nearby_devices() {
  local stale="" d
  direct_link_up || stale=$(cat "$DIRECT_FILE" 2>/dev/null)
  while read -r d; do
    [[ -n $d ]] || continue
    is_tailnet_serial "$d" && continue
    [[ -n $stale && $d == "$stale" ]] && continue
    echo "$d"
  done < <(ready_devices)
}

tailnet_devices() {
  local d
  while read -r d; do
    [[ -n $d ]] && is_tailnet_serial "$d" && echo "$d"
  done < <(ready_devices)
  return 0
}

# Whether the phone answers on this connection. A connection from before a
# network change can still be listed as connected while leading nowhere.
phone_alive() {
  adb_timed 4 -s "$1" shell true &>/dev/null
}

# Whether a running scrcpy uses this connection.
serial_in_use() {
  local pid
  for pid in $(pgrep -x scrcpy); do
    tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qxF -- "$1" && return 0
  done
  return 1
}

# How a serial reaches the phone: usb, direct, wifi or tailscale.
path_of() {
  if is_tailnet_serial "$1"; then
    echo tailscale
  elif [[ -s $DIRECT_FILE && $1 == "$(<"$DIRECT_FILE")" ]]; then
    echo direct
  elif [[ $1 == *:* || $1 == *_adb-tls-connect* ]]; then
    echo wifi
  else
    echo usb
  fi
}

path_label() {
  case $1 in
  usb) echo "USB" ;;
  direct) echo "the direct Wi-Fi link" ;;
  wifi) echo "Wi-Fi" ;;
  tailscale) echo "Tailscale" ;;
  esac
}

# Prints the serial of the phone to use: USB first, then the direct Wi-Fi
# link, then the router, then Tailscale, skipping any that don't answer.
# With "direct", sets up the direct link if it's down.
pick_device() {
  local want_direct=${1:-} serial="" candidates=() c direct="" demoted=""
  adb start-server &>/dev/null

  if [[ -n $SERIAL ]]; then
    if ! all_devices | grep -qxF "$SERIAL"; then
      [[ $SERIAL == *:* ]] && adb_connect "$SERIAL"
      connect_wireless
    fi
    all_devices | grep -qxF "$SERIAL" || die "Phone $SERIAL isn't connected."
    printf '%s' "$SERIAL"
    return
  fi

  [[ -n $(nearby_devices) ]] || connect_wireless

  serial=$(nearby_devices | usb_devices | head -1)
  if [[ -n $serial ]]; then
    learn_tailnet "$serial" &>/dev/null &
    printf '%s' "$serial"
    return
  fi

  # A direct link on another channel than the Wi-Fi connection makes the
  # Wi-Fi card switch back and forth, so the router goes first then.
  if direct=$(direct_serial); then
    if direct_mcc; then demoted=$direct; else candidates+=("$direct"); fi
  fi
  while read -r c; do
    [[ -n $c && $c != "$direct" ]] && candidates+=("$c")
  done < <(nearby_devices)
  [[ -n $demoted ]] && candidates+=("$demoted")
  while read -r c; do
    [[ -n $c ]] && candidates+=("$c")
  done < <(tailnet_devices)

  serial=""
  for c in "${candidates[@]}"; do
    if phone_alive "$c"; then
      serial=$c
      break
    fi
    # Drop a dead connection, unless a window still uses it: a slow one
    # isn't necessarily dead, and dropping it would cut that window too.
    serial_in_use "$c" || adb disconnect "$c" &>/dev/null
  done

  if [[ -z $serial ]] && connect_tailscale; then
    serial=$REMOTE_SERIAL
  fi
  if [[ -z $serial ]]; then
    if adb devices 2>/dev/null | grep -q $'\tunauthorized'; then
      die "Unlock your phone and tap Allow on the USB debugging prompt."
    fi
    die "${REMOTE_ERROR:-No phone found. Turn on Wireless debugging, plug the phone in, or pair it from the Phone menu.}"
  fi

  case $(path_of "$serial") in
  direct)
    learn_tailnet "$serial" &>/dev/null &
    ;;
  wifi)
    learn_tailnet "$serial" &>/dev/null &
    if [[ $want_direct == direct && $DIRECT == auto && -n $(p2p_device) ]] && direct_allowed; then
      if direct=$(direct_connect_locked "$serial"); then
        printf '%s' "$direct"
        return
      fi
      date +%s >"$DIRECT_FAIL_FILE"
      notify "Phone" "Couldn't set up the direct link, so this goes through your Wi-Fi router."
    fi
    ;;
  esac
  printf '%s' "$serial"
}

# ---------------------------------------------------------------- Tailscale

tailscale_enabled() {
  [[ $TAILSCALE != off ]] && command -v tailscale &>/dev/null
}

# Tailscale gives every device an address in 100.64.0.0/10.
is_tailnet_ip() {
  local a b
  IFS=. read -r a b _ <<<"$1"
  [[ $a == 100 && $b =~ ^[0-9]+$ ]] && ((b >= 64 && b <= 127))
}

is_tailnet_serial() {
  is_tailnet_ip "${1%:*}"
}

# The tailnet's entry for the device at this address, if it's on the tailnet.
tailnet_peer() {
  tailscale status --json 2>/dev/null |
    jq -c --arg ip "$1" 'first(.Peer[]? | select(.TailscaleIPs | index($ip))) // empty'
}

# While the phone is nearby, note its Tailscale address and its Wireless
# debugging port, so it can be reached from elsewhere later. Mobile carriers
# hand out addresses in Tailscale's range too, so only an address the tailnet
# knows counts.
learn_tailnet() {
  local serial=$1 ip port old=""
  tailscale_enabled || return 0
  port=$(adb_port "$serial")
  [[ -s $TAILNET_FILE ]] && old=$(<"$TAILNET_FILE")
  [[ -n $port ]] || port=${old#* }
  while read -r ip; do
    is_tailnet_ip "$ip" && [[ -n $(tailnet_peer "$ip") ]] || continue
    [[ "$ip $port" == "$old" ]] || echo "$ip $port" >"$TAILNET_FILE"
    return 0
  done < <(adb -s "$serial" shell ip -4 -o addr show 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }')
}

# The phone's Tailscale address: the one set in TAILSCALE_HOST, the one it
# reported while nearby, or the tailnet's only Android device.
tailnet_address() {
  local ip=""
  if [[ -n $TAILSCALE_HOST ]]; then
    if is_tailnet_ip "$TAILSCALE_HOST"; then
      ip=$TAILSCALE_HOST
    else
      ip=$(tailscale ip -4 "$TAILSCALE_HOST" 2>/dev/null | head -1)
    fi
  elif [[ -s $TAILNET_FILE ]]; then
    read -r ip _ <"$TAILNET_FILE"
  else
    ip=$(tailscale status --json 2>/dev/null | jq -r '[.Peer[]? | select(.OS == "android")]
      | if length == 1 then (.[0].TailscaleIPs[] | select(startswith("100."))) else empty end')
  fi
  [[ -n $ip ]] && printf '%s' "$ip"
}

# adb's own answer is the only sure sign it reached the phone.
adb_connect() {
  local _
  adb_timed 6 connect "$1" 2>/dev/null | grep -q "connected to" || return 1
  for _ in {1..10}; do
    all_devices | grep -qxF "$1" && return 0
    sleep 0.3
  done
  return 1
}

# Reaches the phone over Tailscale. On success sets REMOTE_SERIAL; otherwise
# sets REMOTE_ERROR to what the user can do about it.
REMOTE_SERIAL=""
REMOTE_ERROR=""
connect_tailscale() {
  local ip peer port="" p
  tailscale_enabled || return 1
  ip=$(tailnet_address) || return 1
  peer=$(tailnet_peer "$ip")
  [[ -n $peer ]] || return 1
  if [[ $(jq -r '.Online' <<<"$peer") != true ]]; then
    REMOTE_ERROR="Your phone is offline on Tailscale. Open the Tailscale app on the phone and check it's connected."
    return 1
  fi

  [[ -s $TAILNET_FILE ]] && read -r _ port <"$TAILNET_FILE"
  for p in $port 5555; do
    if adb_connect "$ip:$p"; then
      REMOTE_SERIAL="$ip:$p"
      return 0
    fi
  done

  # Wireless debugging picks a new port each time it's turned on, and only
  # the phone's screen shows it.
  if [[ -z ${PHONELINK_NO_PROMPT:-} ]] && command -v omarchy-menu-input &>/dev/null; then
    p=$(omarchy-menu-input "Phone on Tailscale: turn on Wireless debugging, then enter the port it shows" --width 640) || p=""
    if [[ $p =~ ^[0-9]+$ ]] && ((p > 0 && p < 65536)) && adb_connect "$ip:$p"; then
      echo "$ip $p" >"$TAILNET_FILE"
      REMOTE_SERIAL="$ip:$p"
      return 0
    fi
  fi
  REMOTE_ERROR="Your phone is on Tailscale, but Wireless debugging didn't answer. Turn it on (the phone needs Wi-Fi), then run: phonelink connect <port shown on the phone>"
  return 1
}

# True when Tailscale relays traffic to this address through its servers
# instead of a direct path, which adds lag.
tailnet_relayed() {
  local last
  last=$(tailscale ping -c 5 --timeout 2s "$1" 2>/dev/null | grep '^pong' | tail -1)
  [[ $last == *"via DERP"* ]]
}

# ---------------------------------------------------------------- direct Wi-Fi link

p2p_device() {
  nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "wifi-p2p" { print $1; exit }'
}

direct_link_up() {
  nmcli -t -f NAME connection show --active 2>/dev/null | grep -qxF "$DIRECT_CON"
}

# After a failed attempt, wait a while before trying again on every launch.
direct_allowed() {
  [[ ! -s $DIRECT_FAIL_FILE ]] || (($(date +%s) - $(<"$DIRECT_FAIL_FILE") > 600))
}

# Prints the serial of the phone over the direct link, if the link is up.
direct_serial() {
  local addr
  [[ -s $DIRECT_FILE ]] && direct_link_up || return 1
  addr=$(<"$DIRECT_FILE")
  ready_devices | grep -qxF "$addr" || adb_timed 4 connect "$addr" &>/dev/null
  ready_devices | grep -qxF "$addr" || return 1
  printf '%s' "$addr"
}

# Wireless debugging listens on every network the phone is on, so the port
# from the router connection also works over the direct link.
adb_port() {
  if [[ $1 =~ :([0-9]+)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    adb mdns services 2>/dev/null |
      awk -v n="${1%%.*}" '$1 == n && /_adb-tls-connect/ { sub(/.*:/, "", $NF); print $NF; exit }'
  fi
}

nm_property() {
  busctl --json=short get-property org.freedesktop.NetworkManager "$1" "$2" "$3" 2>/dev/null | jq -r '.data | if type == "array" then .[] else . end'
}

# Prints "mac<TAB>name" for each Wi-Fi Direct device in range.
p2p_peers() {
  local peer
  for peer in $(nm_property "$1" org.freedesktop.NetworkManager.Device.WifiP2P Peers); do
    printf '%s\t%s\n' \
      "$(nm_property "$peer" org.freedesktop.NetworkManager.WifiP2PPeer HwAddress)" \
      "$(nm_property "$peer" org.freedesktop.NetworkManager.WifiP2PPeer Name)"
  done
}

# This computer's Wi-Fi Direct address, as the phone sees it.
our_p2p_address() {
  iw dev 2>/dev/null | awk '$1 == "addr" { addr = $2 } $1 == "type" && $2 == "P2P-device" { print addr; exit }'
}

# Taps Connect on the phone's Wi-Fi Direct invitation, so the user needn't,
# but only when the invitation comes from this computer: while Android asks,
# it keeps the requesting device's address in mSavedPeerConfig.
accept_invitation() {
  local serial=$1 ours=$2 xml node from x1 y1 x2 y2
  [[ -n $ours ]] || return 1
  xml=$(adb -s "$serial" exec-out uiautomator dump /dev/tty 2>/dev/null)
  node=$(grep -oE '<node [^>]*resource-id="android:id/button1"[^>]*package="com\.android\.wifi\.dialog"[^>]*>' <<<"$xml" | head -1)
  [[ -n $node ]] || return 1

  from=$(adb -s "$serial" shell dumpsys wifip2p 2>/dev/null |
    awk '/mSavedPeerConfig/ { found = 1 } found && $1 == "address:" { print $2; exit }' | tr -d '\r')
  [[ -n $from && ${from,,} == "${ours,,}" ]] || return 1

  read -r x1 y1 x2 y2 < <(grep -oE 'bounds="[^"]*"' <<<"$node" | grep -oE '[0-9]+' | tr '\n' ' ')
  adb -s "$serial" shell input tap $(((x1 + x2) / 2)) $(((y1 + y2) / 2)) &>/dev/null
}

# Leaves the Wi-Fi Direct page phonelink opened, without pressing Back in
# whatever the user has switched to since.
close_wifi_direct_page() {
  adb -s "$1" shell dumpsys activity activities 2>/dev/null | grep -m1 'topResumedActivity' |
    grep -q 'WifiP2pSettingsActivity' && adb -s "$1" shell input keyevent KEYCODE_BACK &>/dev/null
}

phone_locked() {
  adb -s "$1" shell dumpsys window 2>/dev/null | grep -q "isKeyguardShowing=true"
}

# Only one direct-link setup at a time. A second caller waits for the first,
# then uses the link it made.
direct_connect_locked() {
  local serial=$1 lock result=""
  exec {lock}>"$STATE_DIR/direct.lock"
  if flock -w 120 "$lock"; then
    result=$(direct_serial) || result=$(direct_connect "$serial") || result=""
  fi
  exec {lock}>&-
  [[ -n $result ]] && printf '%s' "$result"
}

# Links the laptop and the phone (reached as $1 over the router) with
# Wi-Fi Direct, and prints the phone's adb serial over that link.
direct_connect() {
  local serial=$1 dev path port name known peer pid ok iface ip phone ours _
  dev=$(p2p_device)
  [[ -n $dev ]] || return 1
  path=$(nmcli -g GENERAL.DBUS-PATH device show "$dev" 2>/dev/null)
  port=$(adb_port "$serial")
  [[ -n $path && -n $port ]] || return 1

  adb -s "$serial" shell input keyevent KEYCODE_WAKEUP &>/dev/null
  if phone_locked "$serial"; then
    notify -u normal "Phone" "Unlock your phone to set up the fast direct link."
    for _ in {1..30}; do
      sleep 1
      phone_locked "$serial" || break
    done
    phone_locked "$serial" && return 1
  fi

  notify "Phone" "Setting up a direct Wi-Fi link to your phone. Tap Connect on the phone if it asks."
  name=$(adb -s "$serial" shell settings get global device_name 2>/dev/null | tr -d '\r')
  known=$(cat "$DIRECT_PEER_FILE" 2>/dev/null)
  ours=$(our_p2p_address)

  # Android only answers Wi-Fi Direct while its settings page is searching,
  # and only starts searching when the page opens fresh.
  adb -s "$serial" shell am force-stop com.android.settings &>/dev/null
  adb -s "$serial" shell am start -n 'com.android.settings/.Settings\$WifiP2pSettingsActivity' &>/dev/null
  busctl call org.freedesktop.NetworkManager "$path" org.freedesktop.NetworkManager.Device.WifiP2P \
    StartFind 'a{sv}' 1 timeout i 40 &>/dev/null

  for _ in {1..40}; do
    peer=$(p2p_peers "$path" | awk -F'\t' -v n="$name" -v m="${known,,}" '$2 == n || tolower($1) == m { print $1; exit }')
    [[ -n $peer ]] && break
    sleep 1
  done
  if [[ -z $peer ]]; then
    close_wifi_direct_page "$serial"
    return 1
  fi
  echo "$peer" >"$DIRECT_PEER_FILE"

  if nmcli -t -f NAME connection show 2>/dev/null | grep -qxF "$DIRECT_CON"; then
    nmcli connection modify "$DIRECT_CON" wifi-p2p.peer "$peer" &>/dev/null
  else
    nmcli connection add type wifi-p2p con-name "$DIRECT_CON" ifname "$dev" wifi-p2p.peer "$peer" \
      ipv6.method disabled connection.autoconnect no &>/dev/null || return 1
  fi

  nmcli --wait 45 connection up "$DIRECT_CON" &>/dev/null &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    accept_invitation "$serial" "$ours" && break
    sleep 1
  done
  wait "$pid"
  ok=$?
  close_wifi_direct_page "$serial"
  ((ok == 0)) || return 1

  # Android runs the link at .1 and hands the laptop an address. If the laptop
  # ended up running it instead, the phone is the neighbour that asked for one.
  iface=$(nmcli -g GENERAL.IP-IFACE device show "$dev" 2>/dev/null)
  for _ in {1..10}; do
    ip=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }')
    [[ -n $ip ]] && break
    sleep 1
  done
  [[ -n $ip ]] || { direct_link_down; return 1; }
  if [[ ${ip##*.} != 1 ]]; then
    phone="${ip%.*}.1"
  else
    for _ in {1..10}; do
      phone=$(ip -4 neigh show dev "$iface" 2>/dev/null | awk '$1 != "" { print $1; exit }')
      [[ -n $phone ]] && break
      sleep 1
    done
  fi
  [[ -n $phone ]] || { direct_link_down; return 1; }

  for _ in {1..5}; do
    adb connect "$phone:$port" 2>/dev/null | grep -q "connected to" && break
    sleep 1
  done
  ready_devices | grep -qxF "$phone:$port" || { direct_link_down; return 1; }

  echo "$phone:$port" >"$DIRECT_FILE"
  rm -f "$DIRECT_FAIL_FILE"
  printf '%s' "$phone:$port"
}

# Wi-Fi interface and its channel number, for this computer's own Wi-Fi.
wifi_iface() {
  nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }'
}

iface_channel() {
  iw dev "$1" info 2>/dev/null | awk '$1 == "channel" { print $2; exit }'
}

# True when the direct link and the Wi-Fi connection are on different
# channels, which the Wi-Fi card can only serve by switching between them.
direct_mcc() {
  local p2p wifi a b
  p2p=$(nmcli -g GENERAL.IP-IFACE device show "$(p2p_device)" 2>/dev/null)
  wifi=$(wifi_iface)
  [[ -n $p2p && -n $wifi ]] || return 1
  a=$(iface_channel "$p2p")
  b=$(iface_channel "$wifi")
  [[ -n $a && -n $b && $a != "$b" ]]
}

direct_link_down() {
  nmcli connection down "$DIRECT_CON" &>/dev/null
}

direct_disconnect() {
  [[ -s $DIRECT_FILE ]] && adb disconnect "$(<"$DIRECT_FILE")" &>/dev/null
  rm -f "$DIRECT_FILE"
  direct_link_down
}

direct() {
  local serial direct
  if [[ $1 == toggle ]]; then
    direct_link_up && set -- off || set -- on
  fi

  case $1 in
  off)
    direct_disconnect
    notify "Phone" "Direct link closed."
    ;;
  *)
    if direct=$(direct_serial); then
      notify "Phone" "Direct link is already up."
      return
    fi
    [[ -n $(p2p_device) ]] || die "This computer can't do Wi-Fi Direct. It needs NetworkManager with wpa_supplicant and a Wi-Fi card that supports it."
    serial=$(pick_device) || exit 1
    [[ $serial == *:* || $serial == *_adb-tls-connect* ]] || die "Your phone is on USB, which is already the fastest link."
    is_tailnet_serial "$serial" && die "Your phone is connected over Tailscale. The direct link only works when it's next to this computer."
    rm -f "$DIRECT_FAIL_FILE"
    if direct=$(direct_connect_locked "$serial"); then
      notify "Phone" "Direct link is up. Phone windows now skip your Wi-Fi router."
    else
      die "Couldn't set up the direct link. Keep the phone unlocked and close by, then try again."
    fi
    ;;
  esac
}

device_label() {
  local name
  name=$(adb -s "$1" shell settings get global device_name 2>/dev/null | tr -d '\r')
  [[ -z $name || $name == null ]] && name=$(adb -s "$1" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
  printf '%s' "${name:-Phone}"
}

# ---------------------------------------------------------------- app list

# scrcpy prints " * Name<padding> package" (system apps) or " - ..." (others);
# a name of 30 characters or more is followed by the package on its own line.
refresh_apps() {
  local serial=$1 tmp
  tmp=$(mktemp)
  scrcpy -s "$serial" --list-apps 2>&1 | awk '
    /^ [*-] / {
      line = substr($0, 4)
      if (match(line, /  +[^ ]+$/)) {
        name = substr(line, 1, RSTART - 1)
        pkg = substr(line, RSTART); gsub(/ /, "", pkg)
        print name "\t" pkg
        pending = ""
      } else {
        pending = line
      }
      next
    }
    pending != "" && /^ +[^ ]+$/ {
      pkg = $0; gsub(/ /, "", pkg)
      print pending "\t" pkg
      pending = ""
    }
  ' | awk -F'\t' '$2 ~ /^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)+$/' | sort -f -t $'\t' -k1,1 -k2,2 >"$tmp"

  if [[ -s $tmp ]]; then
    mv "$tmp" "$APPS_CACHE"
  else
    rm -f "$tmp"
    die "Couldn't read the app list from the phone."
  fi
}

record_recent() {
  local tmp
  tmp=$(mktemp)
  { echo "$1"; grep -vxF "$1" "$RECENT_FILE" 2>/dev/null; } | head -6 >"$tmp"
  mv "$tmp" "$RECENT_FILE"
}

# ---------------------------------------------------------------- launcher entries

desktop_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//$'\t'/ }
  value=${value//$'\n'/ }
  value=${value//$'\r'/}
  printf '%s' "$value"
}

# App icons come from the app's Google Play page, which tells Google the
# package name. APP_ICONS=off keeps a generic icon instead.
fetch_icon() {
  local pkg=$1 dest="$ICON_DIR/phonelink.$1.png" page url
  [[ $APP_ICONS == play ]] && valid_pkg "$pkg" || return 1
  [[ -s $dest ]] && return 0
  mkdir -p "$ICON_DIR"

  page=$(curl -fsSL --max-time 10 --max-filesize 8000000 -A "Mozilla/5.0" \
    "https://play.google.com/store/apps/details?id=$pkg&hl=en") || return 1
  url=$(grep -oE '<meta property="og:image" content="[^"]+"' <<<"$page" | head -1 | sed -E 's/.*content="([^"]+)"/\1/')
  [[ $url == https://* ]] || return 1

  if curl -fsSL --max-time 10 --max-filesize 2000000 -o "$dest.tmp" "${url%=*}=s256-br30"; then
    mv "$dest.tmp" "$dest"
  else
    rm -f "$dest.tmp"
    return 1
  fi
  gtk-update-icon-cache "$ICON_ROOT" &>/dev/null || true
}

# Every opened app gets a (hidden) desktop entry, so the dock can name its
# window and show its icon. Pinning only makes the entry visible in the launcher.
write_entry() {
  local pkg=$1 name=$2 hidden=$3 icon=phone
  valid_pkg "$pkg" || return 1
  fetch_icon "$pkg" && icon="phonelink.$pkg"
  mkdir -p "$DESKTOP_DIR"
  cat >"$DESKTOP_DIR/phonelink.$pkg.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_escape "$name") (Phone)
Comment=Runs on your phone
Exec=phonelink open $pkg
Icon=$icon
StartupWMClass=phonelink.$pkg
Categories=Utility;
Keywords=android;phone;$pkg;
NoDisplay=$hidden
EOF
}

is_pinned() {
  grep -qx 'NoDisplay=false' "$DESKTOP_DIR/phonelink.$1.desktop" 2>/dev/null
}

# ---------------------------------------------------------------- sound

# Android mixes every app's sound into one output, so a phone window can't
# carry just its own. One hidden, sound-only connection carries the phone's
# sound instead, and the windows carry none. While it runs, the sound plays
# here; without it, on the phone.
#
# Each window remembers where its sound should play, under "mirror" or the
# app's package name. Opening a window set to this computer brings the sound
# here. Switching a window moves the sound at once, and since every window
# shares it, for all of them. When the last phone window closes, the sound
# goes back to the phone.
SOUND_ID="phonelink-sound"
SOUND_PREFS="$STATE_DIR/sound"

# The setting key for a phonelink window id or class, if it is one.
window_key() {
  case $1 in
  phonelink) echo mirror ;;
  phonelink.*) echo "${1#phonelink.}" ;;
  esac
}

# Prints "key<TAB>pid" for each phone window on screen. A scrcpy without a
# window (one still starting, or a test run) doesn't count.
open_windows() {
  local class pid
  while IFS=$'\t' read -r class pid; do
    printf '%s\t%s\n' "$(window_key "$class")" "$pid"
  done < <(hyprctl clients -j 2>/dev/null |
    jq -r '.[] | select(.class | test("^phonelink(\\..+)?$")) | "\(.class)\t\(.pid)"')
}

open_window_keys() {
  open_windows | cut -f1 | sort -u
}

is_open() {
  open_window_keys | grep -qxF "$1"
}

sound_pref() {
  local pref
  pref=$(awk -v k="$1" '$1 == k { print $2; exit }' "$SOUND_PREFS" 2>/dev/null)
  [[ $pref == pc || $pref == phone ]] || pref=$SOUND
  [[ $pref == phone ]] && echo phone || echo pc
}

set_sound_pref() {
  local tmp
  tmp=$(mktemp)
  { awk -v k="$1" '$1 != k' "$SOUND_PREFS" 2>/dev/null; echo "$1 $2"; } >"$tmp"
  mv "$tmp" "$SOUND_PREFS"
}

# One change to the phone's sound at a time. The sound connection starts in
# the background, so without this a quick second switch could miss it and
# start another, and the sound would play twice.
SOUND_LOCK=""
sound_lock() {
  exec {SOUND_LOCK}>"$STATE_DIR/sound.lock"
  flock -w "${1:-15}" "$SOUND_LOCK" && return 0
  sound_unlock
  return 1
}

sound_unlock() {
  [[ -n $SOUND_LOCK ]] && exec {SOUND_LOCK}>&-
  SOUND_LOCK=""
}

sound_pids() {
  phonelink_processes | awk -F'\t' -v id="$SOUND_ID" '$2 == id { print $1 }'
}

sound_pid() {
  sound_pids | head -1
}

# The sound connection's sessions: one normally, but stop() ends any.
sound_session_pids() {
  local d argv
  for d in /proc/[0-9]*; do
    mapfile -d '' -t argv 2>/dev/null <"$d/cmdline" || continue
    [[ ${argv[2]:-} == __sound && ${argv[1]:-} == */phonelink ]] && echo "${d#/proc/}"
  done
  return 0
}

# The sound plays here while its session runs, reconnecting included.
sound_here() {
  [[ -n $(sound_session_pids) || -n $(sound_pids) ]]
}

# The device a running scrcpy was started for.
process_serial() {
  tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | awk 'prev == "-s" { print; exit } { prev = $0 }'
}

# Other scrcpy runs that play a phone's sound here, such as one started by
# hand or by an older phonelink. Starting the sound connection beside one
# would play the sound twice.
foreign_sound_pids() {
  local pid args
  for pid in $(pgrep -x scrcpy); do
    tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -qxF "SDL_APP_ID=$SOUND_ID" && continue
    args=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null) || continue
    grep -qxE -- '--no-audio|--no-audio-playback|--otg|--list-[a-z-]+|--version|--help|-[hv]' <<<"$args" && continue
    echo "$pid"
  done
  return 0
}

# Windows on screen, plus window sessions still running, which includes ones
# opening or reconnecting their window. Only used to decide when the sound
# can go back to the phone. $1 leaves out a window that's closing: its
# session is still running while it asks.
live_window_keys() {
  local leave=${1:-} pid argv
  {
    open_window_keys
    for pid in $(session_pids); do
      mapfile -d '' -t argv 2>/dev/null <"/proc/$pid/cmdline" || continue
      case ${argv[3]:-} in
      mirror) echo mirror ;;
      app) [[ -n ${argv[4]:-} ]] && echo "${argv[4]}" ;;
      esac
    done
  } | sort -u | grep -vxF -- "${leave:-//none//}" || true
}

# Ends the sound session and its scrcpy, and waits until both have.
sound_stop() {
  local pid helpers alive _
  sound_here || return 0
  if [[ -n ${PHONELINK_DRY_RUN:-} ]]; then
    echo "sound: stop"
    return
  fi
  # scrcpy's adb helper keeps the phone capturing until it exits, and a new
  # capture can't start while it does.
  helpers=$(for pid in $(sound_pids); do pgrep -P "$pid"; done)
  for pid in $(sound_session_pids) $(sound_pids); do
    kill -TERM "$pid" 2>/dev/null
  done
  for _ in {1..40}; do
    alive=false
    for pid in $helpers; do
      kill -0 "$pid" 2>/dev/null && alive=true
    done
    ! $alive && ! sound_here && return 0
    sleep 0.1
  done
  # Still running after 4 seconds. scrcpy's adb child would keep the phone
  # capturing its sound, so that goes too.
  for pid in $(sound_pids); do
    pkill -KILL -P "$pid" 2>/dev/null
  done
  for pid in $(sound_session_pids) $(sound_pids) $helpers; do
    kill -KILL "$pid" 2>/dev/null
  done
  sleep 0.2
}

# Starts the sound session for the device, unless one runs already (it finds
# its own way to the phone from then on), and waits until it plays.
sound_start() {
  local serial=$1 foreign runner _
  sound_here && return 0

  foreign=$(foreign_sound_pids)
  if [[ -n $foreign ]]; then
    notify -u normal "Phone sound stays on the phone" \
      "Another scrcpy (process ${foreign//$'\n'/, }) is already playing a phone's sound here. Close it and switch again, so the sound doesn't play twice."
    return 1
  fi
  if [[ -n ${PHONELINK_DRY_RUN:-} ]]; then
    echo "sound: start $serial"
    return 0
  fi

  if command -v uwsm-app &>/dev/null; then
    runner=(setsid -f uwsm-app -- "$SELF" __sound "$serial")
  else
    runner=(setsid -f "$SELF" __sound "$serial")
  fi
  (
    [[ -n $LAUNCH_LOCK ]] && exec {LAUNCH_LOCK}>&-
    [[ -n $SOUND_LOCK ]] && exec {SOUND_LOCK}>&-
    exec "${runner[@]}" &>/dev/null
  )

  for _ in {1..80}; do
    [[ -n $(sound_pids) ]] && return 0
    sleep 0.1
  done
  notify -u normal "Phone sound stays on the phone" "The sound connection didn't start. See $LOG_DIR/$SOUND_ID.log"
  sound_stop
  return 1
}

# The sound connection's session. Like a window's, it starts scrcpy again on
# the way back to the phone when the link drops, and moves to a clearly better
# connection when one turns up. It ends when stopped, or when no phone window
# is left to want the sound.
sound_session() {
  local serial=$1 log path args code reason next started tick now last error up=false tries=0
  APP_ID=$SOUND_ID
  log="$LOG_DIR/$SOUND_ID.log"
  local state="$STATE_DIR/session.$SOUND_ID.state"

  trap 'STOPPING=1; end_scrcpy' TERM INT HUP

  while [[ -z $STOPPING ]]; do
    path=$(path_of "$serial")
    args=(-s "$serial" --no-video --no-control --no-window --require-audio)
    # A longer buffer rides out network hiccups instead of crackling.
    case $path in
    wifi | direct) args+=(--audio-buffer=80) ;;
    tailscale) args+=(--audio-buffer=150) ;;
    esac
    SDL_APP_ID="$SOUND_ID" scrcpy "${args[@]}" >"$log" 2>&1 &
    SCRCPY_PID=$!
    echo "up $path" >"$state"
    log_event "start: sound over $path $serial"

    reason="" started=$SECONDS tick=0 last=$(date +%s)
    while kill -0 "$SCRCPY_PID" 2>/dev/null && [[ -z $STOPPING ]]; do
      sleep 2 &
      wait $!
      [[ -n $STOPPING ]] && break
      tick=$((tick + 1))
      now=$(date +%s)
      ((SECONDS - started > 4)) && up=true
      # A long gap between checks means the computer slept, and the link
      # may have died with it.
      if ((now - last > 15)) && ! phone_alive "$serial"; then
        reason=stall
        break
      fi
      last=$now
      if ((tick % 5 == 0)) && next=$(better_path "$serial"); then
        reason=upgrade
        log_event "sound: better path $next"
        break
      fi
    done

    [[ -n $reason ]] && end_scrcpy
    wait "$SCRCPY_PID" 2>/dev/null
    code=$?
    SCRCPY_PID=""
    log_event "sound ended: code $code${reason:+, $reason}${STOPPING:+, stopping}"
    [[ -n $STOPPING ]] && break

    if [[ $reason == upgrade ]]; then
      serial=$next
      continue
    fi
    ((code == 0)) && break
    if ((code == 1)) && ! $up; then
      # The phone may still be letting go of the last capture; try again.
      if ((tries < 2)); then
        tries=$((tries + 1))
        sleep 1 &
        wait $!
        continue
      fi
      error=$(grep -E "ERROR:" "$log" | tail -1 | sed 's/.*ERROR: *//')
      notify -u normal "Phone sound stays on the phone" "${error:-It could not be played here. See $log}"
      break
    fi

    # The link dropped. Find the phone again while phone windows want it.
    [[ -n $(live_window_keys) ]] || break
    ((RECONNECT_SECS > 0)) || break
    echo "reconnecting $path" >"$state"
    reconnect "$RECONNECT_SECS" || break
    serial=$RECONNECT_SERIAL
    log_event "sound reconnected: $serial"
  done
  rm -f "$state"
}

# Moves the phone's sound to "pc" or "phone" now. $2 is the device to use,
# by default the one an open phone window uses. Call with the lock held.
sound_to() {
  local serial=${2:-} pid
  if [[ $1 == phone ]]; then
    sound_stop
    return
  fi
  if [[ -z $serial ]]; then
    pid=$(open_windows | head -1 | cut -f2)
    [[ -n $pid ]] && serial=$(process_serial "$pid")
  fi
  if [[ -z $serial ]]; then
    notify -u normal "Phone sound stays on the phone" "Couldn't tell which connection the phone window uses."
    return 1
  fi
  sound_start "$serial"
}

# A window set to this computer brings the sound here. One set to the phone
# leaves it where it is, so it doesn't silence the others.
sound_window_opened() {
  [[ $(sound_pref "$1") == pc ]] || return 0
  sound_lock || return 0
  sound_to pc "$2"
  sound_unlock
}

# $1 is the window that closed.
sound_window_closed() {
  sound_lock || return 0
  [[ -z $(live_window_keys "${1:-}") ]] && sound_stop
  sound_unlock
}

sound_label() {
  [[ $1 == mirror ]] && echo "Mirror" || app_name "$1"
}

# phonelink sound [pc|phone|toggle] [mirror|<package>]
# Without a window named, it's the focused phone window, or else all of them.
# A window that isn't open only remembers the setting for next time.
sound_cmd() {
  local mode=${1:-toggle} key=${2:-} keys=() k new now open=false title body
  [[ $mode =~ ^(pc|phone|toggle)$ ]] || die "Usage: phonelink sound [pc|phone|toggle] [mirror|<package>]"

  if [[ -z $key ]]; then
    key=$(window_key "$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty')")
  fi
  if [[ -n $key ]]; then
    [[ $key == mirror ]] || valid_pkg "$key" || die "Not a phone window: $key"
    keys=("$key")
    is_open "$key" && open=true
    title=$(sound_label "$key")
  else
    mapfile -t keys < <(open_window_keys)
    ((${#keys[@]})) || die "Open a phone app or the mirror first, then switch its sound."
    open=true
    title="Phone sound"
  fi

  sound_lock || die "Another change to the phone's sound is taking too long. Try again in a moment."

  new=$mode
  if [[ $mode == toggle ]]; then
    if $open; then
      if sound_here; then new=phone; else new=pc; fi
    else
      if [[ $(sound_pref "$key") == pc ]]; then new=phone; else new=pc; fi
    fi
  fi
  for k in "${keys[@]}"; do
    set_sound_pref "$k" "$new"
  done

  if ! $open; then
    sound_unlock
    [[ $new == pc ]] && body="Opens with its sound on this computer." || body="Opens with its sound on the phone."
    notify "$title" "$body"
    return
  fi

  sound_to "$new"
  if sound_here; then now=pc; else now=phone; fi
  sound_unlock

  # sound_start has already said why if the sound couldn't come here.
  [[ $now == "$new" ]] || return 1
  [[ $new == pc ]] && body="Sound now plays on this computer." || body="Sound now plays on the phone."
  if (($(open_window_keys | wc -l) > 1)); then
    body+=" Phone windows share one sound, so this goes for all of them."
  fi
  notify "$title" "$body"
}

# ---------------------------------------------------------------- launching

# A phone window runs as a session: it starts scrcpy, watches the link under
# it, and starts scrcpy again when the link drops, freezes, falls behind, or
# a better one turns up. scrcpy can't change its video settings or its
# connection while it runs, so each of those means a new scrcpy.

# Video quality steps, best first: bit rate, frame rate, and a size cap for
# the mirror. scrcpy streams over TCP and never drops frames itself, so a
# bit rate the link can't carry turns into delay that keeps growing.
TIER_RATES=(16M 8M 5M 3M 1500K)
TIER_FPS=(60 60 60 30 24)
TIER_MIRROR_SIZE=("" "" "" 1280 1024)
TIER_LAST=4

# Runs a session detached from whatever launched us.
spawn_session() {
  local runner
  if command -v uwsm-app &>/dev/null; then
    runner=(setsid -f uwsm-app -- "$SELF" __session "$@")
  else
    runner=(setsid -f "$SELF" __session "$@")
  fi
  # What it starts mustn't hold phonelink's locks for as long as it runs.
  (
    [[ -n $LAUNCH_LOCK ]] && exec {LAUNCH_LOCK}>&-
    [[ -n $SOUND_LOCK ]] && exec {SOUND_LOCK}>&-
    exec "${runner[@]}" &>/dev/null
  )
}

# A phone window takes a few seconds to appear. Opening the same one again
# meanwhile would start it twice, so the second attempt stands down while the
# first holds this lock, and the first waits until its window is up.
LAUNCH_LOCK=""
launch_lock() {
  exec {LAUNCH_LOCK}>"$STATE_DIR/launch.$1.lock"
  flock -n "$LAUNCH_LOCK"
}

# Window sessions, by their exact arguments rather than any text that
# merely mentions them.
session_pids() {
  local d argv
  for d in /proc/[0-9]*; do
    mapfile -d '' -t argv 2>/dev/null <"$d/cmdline" || continue
    [[ ${argv[2]:-} == __session && ${argv[1]:-} == */phonelink ]] && echo "${d#/proc/}"
  done
  return 0
}

# What sessions decide, and why, for when something needs explaining.
SESSION_LOG="$LOG_DIR/sessions.log"
log_event() {
  [[ -f $SESSION_LOG ]] && (($(stat -c %s "$SESSION_LOG") > 1000000)) && mv "$SESSION_LOG" "$SESSION_LOG.old"
  printf '%s %s %s\n' "$(date '+%F %T')" "${APP_ID:-phonelink}" "$*" >>"$SESSION_LOG"
}

# A session holds its lock for as long as it runs, reconnecting included.
session_running() {
  local fd free=false
  exec {fd}>"$STATE_DIR/session.$1.lock"
  flock -n "$fd" && free=true
  exec {fd}>&-
  ! $free
}

wait_for_window() {
  local _
  [[ -n ${PHONELINK_DRY_RUN:-} ]] && return 0
  for _ in {1..80}; do
    hyprctl clients -j 2>/dev/null | jq -e --arg c "$1" 'any(.[]; .class == $c)' &>/dev/null && return 0
    sleep 0.25
  done
  return 1
}

# Prints "address workspace" of the window with this class.
window_of() {
  hyprctl clients -j 2>/dev/null |
    jq -r --arg c "$1" 'first(.[] | select(.class == $c) | "\(.address) \(.workspace.name)") // empty'
}

# Puts the next window of this class on the workspace the old one was on,
# without switching to it, through a window rule that's dropped once the
# window is up.
place_window() {
  local app_id=$1 workspace=$2 class
  [[ $workspace =~ ^[A-Za-z0-9:_-]+$ ]] || return 0
  [[ $workspace == "$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name')" ]] && return 0
  class="^${app_id//./\\\\.}\$"
  hyprctl eval "phonelink_rules = phonelink_rules or {}
local old = phonelink_rules['$app_id']
if old then old:set_enabled(false) end
phonelink_rules['$app_id'] = hl.window_rule({ match = { class = '$class' }, workspace = '$workspace silent' })" &>/dev/null
}

release_window_rule() {
  hyprctl eval "local rule = phonelink_rules and phonelink_rules['$1']
if rule then rule:set_enabled(false); phonelink_rules['$1'] = nil end" &>/dev/null
}

# The phone's address and port under an adb serial, to watch the link by.
transport_of() {
  if [[ $1 =~ ^([0-9.]+):([0-9]+)$ ]]; then
    echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
  elif [[ $1 == *_adb-tls-connect* ]]; then
    adb mdns services 2>/dev/null | awk -v n="${1%%._adb-tls-connect*}" \
      '$1 == n && /_adb-tls-connect/ { split($NF, a, ":"); print a[1], a[2]; exit }'
  fi
}

# The adb server's process, to tell its connections from other programs'.
adb_server_pid() {
  ss -Hltnp "sport = :${ANDROID_ADB_SERVER_PORT:-5037}" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2
}

# Prints "idle-ms queue-ms" for the adb server's connection to the phone,
# from the kernel's view of it: how long since data last arrived, and how
# far the round trip has grown over its best, which is the backlog on the
# link. $3 is the adb server's process.
link_stats() {
  ss -tinpH state established "( dst $1 and dport = :$2 )" 2>/dev/null | awk -v want="pid=$3," '
    /users:\(\(/ { mine = index($0, want) > 0; next }
    mine { for (i = 1; i <= NF; i++) {
        n = index($i, ":"); if (!n) continue
        k = substr($i, 1, n - 1); v = substr($i, n + 1)
        if (k == "lastrcv") idle = v
        else if (k == "rtt") { split(v, r, "/"); rtt = r[1] }
        else if (k == "minrtt") min = v
      } }
    END { if (idle != "") printf "%d %d\n", idle, rtt - min }'
}

# Prints "serialno ssid tx-mbps" for the phone, as far as it can tell, in
# one round trip. tx-mbps is the speed Android estimates for its Wi-Fi uplink.
phone_info() {
  adb -s "$1" shell 'getprop ro.serialno; cmd wifi status 2>/dev/null' 2>/dev/null | tr -d '\r' | awk '
    NR == 1 { serial = $0 }
    /Wifi is connected to "/ { if (match($0, /"[^"]*"/)) ssid = substr($0, RSTART + 1, RLENGTH - 2) }
    /Calculated Tx *:/ { if (match($0, /Calculated Tx *: *[0-9]+/)) { t = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", t); tx = t } }
    END {
      gsub(/[^A-Za-z0-9]/, "", serial); gsub(/[ \t]/, "_", ssid)
      print (serial != "" ? serial : "unknown"), (ssid != "" ? ssid : "-"), (tx != "" ? tx : 0)
    }'
}

# Whether the phone has a hardware H.265 encoder, which keeps the picture
# sharper at low bit rates. Checked once per phone, in the background.
detect_hevc() {
  local out
  out=$(timeout 30 scrcpy -s "$1" --list-encoders --no-audio 2>&1) || return 0
  grep -q -- '--video-codec=' <<<"$out" || return 0
  if grep -qE -- '--video-codec=h265 .*\(hw\)' <<<"$out"; then
    echo yes >"$STATE_DIR/hevc.$2"
  else
    echo no >"$STATE_DIR/hevc.$2"
  fi
}

# The quality step that last kept up on a path and network, if any.
quality_get() {
  awk -v k="$1" '$1 == k { print $2; exit }' "$QUALITY_FILE" 2>/dev/null
}

quality_set() {
  local tmp
  tmp=$(mktemp)
  {
    awk -v k="$1" '$1 != k' "$QUALITY_FILE" 2>/dev/null
    [[ -n ${2:-} ]] && echo "$1 $2"
  } >"$tmp"
  mv "$tmp" "$QUALITY_FILE"
}

# The quality step to start at, from how the phone is connected, how fast
# its Wi-Fi is, what kept up on this network before, and how many other
# phone windows share the link.
start_tier() {
  local path=$1 tx=$2 others=$3 key=$4 tier learned
  case $path in
  usb) echo 0; return ;;
  tailscale) tier=3 ;;
  *) tier=1 ;;
  esac
  if [[ $path != direct ]] && ((tx > 0)); then
    if ((tx < 12)); then
      tier=$((tier + 2))
    elif ((tx < 25)); then
      tier=$((tier + 1))
    fi
  fi
  ((others > 0)) && tier=$((tier + 1))
  learned=$(quality_get "$key")
  [[ $learned =~ ^[0-9]+$ ]] && ((learned > tier)) && tier=$learned
  ((tier > TIER_LAST)) && tier=$TIER_LAST
  echo "$tier"
}

# Sets ARGS to scrcpy's arguments for a window. Your own options come after
# the automatic ones, so they win.
ARGS=()
build_args() {
  local kind=$1 pkg=$2 name=$3 serial=$4 tier=$5 hevc=$6 path wargs
  path=$(path_of "$serial")
  mapfile -t wargs < <(window_args)
  ARGS=(-s "$serial")
  if [[ $kind == mirror ]]; then
    ARGS+=(--window-title="$name")
  else
    ARGS+=(--new-display="$(tile_size)/$APP_DPI" --flex-display --start-app="$pkg" --window-title="$name")
  fi
  ARGS+=("${wargs[@]}")

  if [[ $ADAPT != off ]]; then
    ARGS+=(--video-bit-rate="${TIER_RATES[tier]}" --max-fps="${TIER_FPS[tier]}")
    ((tier >= 2)) && [[ $hevc == yes ]] && ARGS+=(--video-codec=h265)
  fi

  ARGS+=("${COMMON_ARGS[@]}")
  if [[ $kind == mirror ]]; then
    ARGS+=("${MIRROR_ARGS[@]}")
    [[ $ADAPT != off && -n ${TIER_MIRROR_SIZE[tier]} ]] && ARGS+=(--max-size="${TIER_MIRROR_SIZE[tier]}")
  else
    ARGS+=("${APP_ARGS[@]}")
  fi
  [[ $path == tailscale ]] && ARGS+=("${REMOTE_ARGS[@]}")
  # The phone's sound travels on its own connection (see "sound" above).
  ARGS+=(--no-audio)
  return 0
}

# A clearly better way to the phone than the current one, if it's already
# connected: USB over anything, anything nearby over Tailscale.
better_path() {
  local current=$1 now candidate=""
  [[ -z $SERIAL ]] || return 1
  now=$(path_of "$current")
  [[ $now == usb ]] && return 1
  candidate=$(nearby_devices | usb_devices | head -1)
  if [[ -z $candidate && $now == tailscale ]]; then
    candidate=$(direct_serial) || candidate=$(nearby_devices | head -1)
  fi
  [[ -n $candidate && $candidate != "$current" ]] && phone_alive "$candidate" || return 1
  printf '%s' "$candidate"
}

# Finds the phone again after a drop, whichever way works, for up to $1
# seconds. Sets RECONNECT_SERIAL.
RECONNECT_SERIAL=""
reconnect() {
  local deadline=$((SECONDS + $1)) pause=1 serial
  RECONNECT_SERIAL=""
  while ((SECONDS < deadline)) && [[ -z $STOPPING ]]; do
    adb reconnect offline &>/dev/null
    serial=$(PHONELINK_QUIET=1 PHONELINK_NO_PROMPT=1 pick_device 2>/dev/null) || serial=""
    if [[ -n $serial ]]; then
      RECONNECT_SERIAL=$serial
      return 0
    fi
    sleep "$pause" &
    wait $!
    ((pause < 5)) && pause=$((pause + 1))
  done
  return 1
}

# One notification per session, replaced as things change.
NOTE_ID=0
session_note() {
  local id
  id=$(omarchy-notification-send --app-name phonelink -g 󰄜 -u "${3:-low}" -r "$NOTE_ID" -p "$1" "$2" 2>/dev/null) || {
    notify -u "${3:-low}" "$1" "$2"
    return 0
  }
  [[ $id =~ ^[0-9]+$ ]] && NOTE_ID=$id
  return 0
}

SCRCPY_PID=""
STOPPING=""
end_scrcpy() {
  local _
  [[ -n $SCRCPY_PID ]] || return 0
  kill -TERM "$SCRCPY_PID" 2>/dev/null
  for _ in {1..20}; do
    kill -0 "$SCRCPY_PID" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -KILL "$SCRCPY_PID" 2>/dev/null
  return 0
}

session() {
  local kind=$1 pkg=$2 name=$3 serial=$4
  local app_id=phonelink log state path serialno ssid tx key hevc tier="" others code reason
  local host port idle queue shown=false ever_shown=false workspace="" address now last started
  local stall cong tick changed=0 lowered=false relaunch="" next="" error hevc_retry=true
  local workspace_now limit=50 learned server every=10
  [[ $kind == app ]] && app_id="phonelink.$pkg"
  APP_ID=$app_id
  log="$LOG_DIR/$app_id.log"
  state="$STATE_DIR/session.$app_id.state"

  exec {SESSION_LOCK}>"$STATE_DIR/session.$app_id.lock"
  flock -n "$SESSION_LOCK" || exit 0
  trap 'STOPPING=1; end_scrcpy' TERM INT HUP

  while [[ -z $STOPPING ]]; do
    path=$(path_of "$serial")
    read -r serialno ssid tx < <(phone_info "$serial")
    key="$path:$ssid"
    hevc=$(cat "$STATE_DIR/hevc.$serialno" 2>/dev/null)
    [[ -n $hevc || $serialno == unknown ]] ||
      (exec {SESSION_LOCK}>&-; detect_hevc "$serial" "$serialno" &>/dev/null &)
    # Backlog, in ms, that counts as falling behind. PHONELINK_QUEUE_LIMIT
    # overrides it for testing.
    limit=50
    [[ $path == tailscale ]] && limit=150
    limit=${PHONELINK_QUEUE_LIMIT:-$limit}
    every=10
    [[ $path == tailscale ]] && every=3

    if [[ -z $tier ]]; then
      others=0
      [[ $path != usb ]] && others=$(hyprctl clients -j 2>/dev/null |
        jq --arg c "$app_id" '[.[] | select(.class | startswith("phonelink")) | select(.class != $c)] | length')
      tier=$(start_tier "$path" "${tx:-0}" "${others:-0}" "$key")
      if [[ $path == tailscale ]] && tailnet_relayed "${serial%:*}"; then
        ((tier < TIER_LAST)) && tier=$((tier + 1))
        session_note "Phone over Tailscale" "Tailscale is relaying this connection through its servers, so the video is lighter. It often finds a direct path within a minute." normal
      fi
    fi
    build_args "$kind" "$pkg" "$name" "$serial" "$tier" "$hevc"
    $ever_shown && place_window "$app_id" "$workspace"
    SDL_APP_ID="$app_id" scrcpy "${ARGS[@]}" >"$log" 2>&1 {SESSION_LOCK}>&- &
    SCRCPY_PID=$!
    log_event "start: $path $serial, quality step $((tier + 1)) (${TIER_RATES[tier]}bit/s), h265=${hevc:-unknown}, link ${tx:-?} Mbit/s, network $ssid"
    echo "up $path $tier" >"$state"

    read -r host port < <(transport_of "$serial")
    server=$(adb_server_pid)
    reason="" shown=false stall=0 cong=0 tick=0
    started=$SECONDS last=$(date +%s)
    while kill -0 "$SCRCPY_PID" 2>/dev/null && [[ -z $STOPPING ]]; do
      sleep 2 &
      wait $!
      [[ -n $STOPPING ]] && break
      tick=$((tick + 1))
      now=$(date +%s)

      # Test sessions without a display count as shown once scrcpy is up.
      [[ -n ${PHONELINK_HEADLESS:-} ]] && ((SECONDS - started > 4)) && shown=true ever_shown=true
      if ! $shown || ((tick % 3 == 0)); then
        read -r address workspace_now < <(window_of "$app_id")
        if [[ -n ${address:-} ]]; then
          if ! $shown && $ever_shown; then
            release_window_rule "$app_id"
            [[ -n $relaunch ]] && session_note "Phone" "$relaunch"
            relaunch=""
          fi
          shown=true ever_shown=true workspace=$workspace_now
        fi
      fi

      # A long gap between checks means the computer slept, and the link
      # may have died with it.
      if ((now - last > 15)) && ! phone_alive "$serial"; then
        reason=stall
        log_event "woke from sleep with the link gone"
        break
      fi
      last=$now

      if [[ -n $host ]] && $shown && ((SECONDS - started > 8)); then
        read -r idle queue < <(link_stats "$host" "$port" "$server")
        # The phone sends a frame at least every 100 ms, even of a still
        # screen, so seconds without data means the link is gone.
        if [[ -z ${idle:-} ]] || ((idle > 5000)); then
          stall=$((stall + 1))
        else
          stall=0
        fi
        if ((stall >= 2)); then
          reason=stall
          log_event "frozen: no data for ${idle:-?} ms"
          break
        fi

        if [[ $ADAPT != off && -n ${queue:-} ]] && ((queue > limit)); then
          cong=$((cong + 1))
        elif ((cong > 0)); then
          cong=$((cong - 1))
        fi
        if ((cong >= 5 && tier < TIER_LAST && SECONDS - changed >= 30)); then
          reason=congested
          log_event "falling behind: ${queue} ms backlog"
          break
        fi
      fi

      # Over Tailscale, look often: once the phone is home, its Tailscale
      # stream tends to stall within seconds of the nearby connection
      # appearing, so the switch has to come first.
      if ((tick % every == 0)) && next=$(better_path "$serial"); then
        reason=upgrade
        log_event "better path: $next"
        break
      fi
    done

    [[ -n $reason ]] && end_scrcpy
    wait "$SCRCPY_PID" 2>/dev/null
    code=$?
    SCRCPY_PID=""
    log_event "scrcpy ended: code $code${reason:+, $reason}${STOPPING:+, stopping}"
    [[ -n $STOPPING ]] && break

    if grep -q "INJECT_EVENTS" "$log"; then
      session_note "$name" "The phone blocked mouse and keyboard input. Samsung: turn off Settings › Security and privacy › Auto Blocker. Xiaomi: turn on Developer options › USB debugging (Security settings)." normal
    fi

    case $reason in
    congested)
      tier=$((tier + 1))
      quality_set "$key" "$tier"
      changed=$SECONDS
      if ! $lowered; then
        relaunch="Lowered the video quality to keep up with the connection."
        lowered=true
      fi
      continue
      ;;
    upgrade)
      serial=$next tier=""
      relaunch="Switched to $(path_label "$(path_of "$serial")")."
      continue
      ;;
    stall) ;;
    *)
      case $code in
      0) break ;;
      2) ;;
      1)
        if ! $ever_shown; then
          # A phone whose H.265 encoder lets it down gets H.264 from then on.
          if $hevc_retry && [[ " ${ARGS[*]} " == *" --video-codec=h265 "* ]]; then
            echo no >"$STATE_DIR/hevc.$serialno"
            hevc_retry=false
            continue
          fi
          error=$(grep -E "ERROR:" "$log" | tail -1 | sed 's/.*ERROR: *//')
          session_note "$name couldn't start" "${error:-See $log}" normal
          break
        fi
        ;;
      *) break ;;
      esac
      ;;
    esac

    # The link dropped or froze. Find the phone again, any way that works.
    if ((RECONNECT_SECS <= 0)); then
      session_note "$name" "Phone disconnected."
      break
    fi
    echo "reconnecting $path $tier" >"$state"
    session_note "Phone" "Lost the connection to your phone. Reconnecting…"
    # Drop the connection only if the phone stopped answering on it; other
    # windows may share it, and a frozen scrcpy doesn't mean a dead link.
    [[ $path != usb ]] && ! phone_alive "$serial" && adb disconnect "$serial" &>/dev/null
    if ! reconnect "$RECONNECT_SECS"; then
      [[ -n $STOPPING ]] && break
      session_note "Phone" "Couldn't reconnect to your phone. Check it's on Wi-Fi with Wireless debugging on, then open the window again." normal
      break
    fi
    serial=$RECONNECT_SERIAL tier=""
    log_event "reconnected: $serial"
    relaunch="Reconnected over $(path_label "$(path_of "$serial")")."
  done

  # Quality that held up for ten minutes earns back a step next time.
  if [[ -n ${key:-} ]] && ! $lowered && ((SECONDS >= 600)); then
    learned=$(quality_get "$key")
    if [[ $learned =~ ^[0-9]+$ ]]; then
      if ((learned > 0)); then quality_set "$key" $((learned - 1)); else quality_set "$key" ""; fi
    fi
  fi
  release_window_rule "$app_id"
  rm -f "$state"
  sound_window_closed "$(window_key "$app_id")"
}

# Runs scrcpy once under a phonelink app id, as earlier versions did for
# every window. Kept for scripts that start their own streams this way.
run_plain() {
  local app_id=$1
  shift 2
  SDL_APP_ID="$app_id" scrcpy "$@" >"$LOG_DIR/$app_id.log" 2>&1
}

# Prints the scrcpy command a window would run, for PHONELINK_DRY_RUN.
dry_run() {
  local kind=$1 pkg=$2 name=$3 serial=$4 path serialno ssid tx tier
  path=$(path_of "$serial")
  read -r serialno ssid tx < <(phone_info "$serial")
  tier=$(start_tier "$path" "${tx:-0}" 0 "$path:$ssid")
  build_args "$kind" "$pkg" "$name" "$serial" "$tier" "$(cat "$STATE_DIR/hevc.$serialno" 2>/dev/null)"
  printf 'SDL_APP_ID=%q scrcpy' "$([[ $kind == mirror ]] && echo phonelink || echo "phonelink.$pkg")"
  printf ' %q' "${ARGS[@]}"
  echo
}

open_app() {
  local pkg=$1 name serial
  valid_pkg "$pkg" || die "Not an Android package name: $pkg"
  name=$(app_name "$pkg")

  if focus_class "phonelink.$pkg"; then
    record_recent "$pkg"
    return
  fi
  if session_running "phonelink.$pkg"; then
    notify "Phone" "$name is reconnecting to your phone."
    return 0
  fi
  launch_lock "phonelink.$pkg" || return 0

  serial=$(pick_device direct) || exit 1
  if [[ -n ${PHONELINK_DRY_RUN:-} ]]; then
    dry_run app "$pkg" "$name" "$serial"
    return
  fi
  spawn_session app "$pkg" "$name" "$serial"
  sound_window_opened "$pkg" "$serial"

  # Only an app that actually opened becomes recent.
  wait_for_window "phonelink.$pkg" || return 0
  record_recent "$pkg"
  [[ -f "$DESKTOP_DIR/phonelink.$pkg.desktop" ]] ||
    (exec {LAUNCH_LOCK}>&-; write_entry "$pkg" "$name" true &>/dev/null &)
}

mirror() {
  local serial label
  focus_class "phonelink" && return
  if session_running "phonelink"; then
    notify "Phone" "The mirror is reconnecting to your phone."
    return 0
  fi
  launch_lock "phonelink" || return 0

  serial=$(pick_device direct) || exit 1
  label=$(device_label "$serial")
  if [[ -n ${PHONELINK_DRY_RUN:-} ]]; then
    dry_run mirror "" "$label" "$serial"
    return
  fi
  spawn_session mirror "" "$label" "$serial"
  sound_window_opened mirror "$serial"
  wait_for_window "phonelink"
}

choose_app() {
  local rows=() pkg name selection serial

  if [[ ! -s $APPS_CACHE ]]; then
    serial=$(pick_device) || exit 1
    notify "Phone" "Reading apps from your phone…"
    refresh_apps "$serial"
  fi

  rows+=($'󰍹\tMirror whole screen')
  while read -r pkg; do
    name=$(awk -F'\t' -v p="$pkg" '$2 == p { print $1; exit }' "$APPS_CACHE")
    [[ -n $name ]] && rows+=($'󰋚\t'"$name"$'\t'"$pkg")
  done < <(cat "$RECENT_FILE" 2>/dev/null)
  while IFS=$'\t' read -r name pkg; do
    rows+=($'󰀲\t'"$name"$'\t'"$pkg")
  done <"$APPS_CACHE"
  rows+=($'󰑐\tRefresh app list')

  selection=$(omarchy-menu-select "Phone apps" "${rows[@]}" -- --width 560) || exit 0

  case $selection in
  "Mirror whole screen") mirror ;;
  "Refresh app list")
    serial=$(pick_device) || exit 1
    notify "Phone" "Reading apps from your phone…"
    refresh_apps "$serial"
    choose_app
    ;;
  *$'\t'*) open_app "${selection##*$'\t'}" ;;
  esac
}

pin_menu() {
  local rows=() selected=() name pkg chosen serial

  if [[ ! -s $APPS_CACHE ]]; then
    serial=$(pick_device) || exit 1
    notify "Phone" "Reading apps from your phone…"
    refresh_apps "$serial"
  fi

  while IFS=$'\t' read -r name pkg; do
    rows+=($'󰀲\t'"$name"$'\t'"$pkg")
    is_pinned "$pkg" && selected+=(--selected "$name"$'\t'"$pkg")
  done <"$APPS_CACHE"

  chosen=$(omarchy-menu-select "Show in app launcher" "${rows[@]}" -- --multiple --width 560 "${selected[@]}") || exit 0
  chosen=$(jq -r '.[]' <<<"$chosen" 2>/dev/null | awk -F'\t' '{ print $NF }')

  while IFS=$'\t' read -r name pkg; do
    if grep -qxF "$pkg" <<<"$chosen"; then
      is_pinned "$pkg" || write_entry "$pkg" "$name" false
    elif is_pinned "$pkg"; then
      sed -i 's/^NoDisplay=false$/NoDisplay=true/' "$DESKTOP_DIR/phonelink.$pkg.desktop"
    fi
  done <"$APPS_CACHE"

  update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
  notify "Phone" "Pinned phone apps are in the app launcher."
}

# ---------------------------------------------------------------- Wi-Fi

# Waits for the phone just paired at $1 to connect, by its address or by the
# mDNS name it announces from that address.
wait_for_wireless() {
  local ip=$1 instance addr _
  for _ in {1..15}; do
    ready_devices | awk -v p="$ip:" 'index($0, p) == 1 { found = 1 } END { exit !found }' && return 0
    while read -r instance addr; do
      ready_devices | grep -qxF "$instance._adb-tls-connect._tcp" && return 0
      adb connect "$addr" &>/dev/null
    done < <(adb mdns services 2>/dev/null | awk -v p="$ip:" '/_adb-tls-connect/ && index($NF, p) == 1 { print $1, $NF }')
    sleep 1
  done
  return 1
}

finish_pairing() {
  local ip=$1 addr
  echo
  if ! wait_for_wireless "$ip"; then
    echo "Paired, but the phone didn't connect by itself."
    read -rp "IP address & port shown at the top of Wireless debugging: " addr
    adb connect "$addr" | grep -q "connected to" || {
      echo "Couldn't connect to $addr."
      return 1
    }
  fi
  echo -e "\e[32m✓ Connected.\e[0m The phone reconnects by itself whenever Wireless debugging is on."
  echo "Open phone apps with Super + Alt + P."
}

pair_manual() {
  local addr code
  echo
  echo "On the phone, tap 'Pair device with pairing code'."
  read -rp "IP address & port shown there: " addr
  read -rp "Wi-Fi pairing code: " code
  adb_pair "$addr" "$code" || return 1
  finish_pairing "${addr%:*}"
}

adb_pair() {
  local output
  output=$(adb pair "$1" "$2" 2>&1)
  echo "$output"
  grep -q "Successfully paired" <<<"$output"
}

pair() {
  # Started from a menu or keybinding: open a terminal to show the QR code in.
  if [[ ! -t 0 ]]; then
    exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="Pair phone" \
      -e bash -c '"$0" pair; code=$?; ((code == 130)) || omarchy-show-done $code' "$SELF"
  fi
  command -v qrencode &>/dev/null || die "qrencode is missing. Install it with: omarchy pkg add qrencode"

  local name pass addr key deadline
  name="phonelink-$RANDOM$RANDOM"
  pass=$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 12)
  adb start-server &>/dev/null

  clear
  echo "Pair your phone over Wi-Fi (same network as this computer)"
  echo
  echo "On the phone: Settings › Developer options › Wireless debugging (on)"
  echo "              › Pair device with QR code, and scan this:"
  qrencode -t ansiutf8 -m 2 "WIFI:T:ADB;S:$name;P:$pass;;"
  echo "Waiting for the phone… (c: use a pairing code instead, q: quit)"

  deadline=$((SECONDS + 300))
  while ((SECONDS < deadline)); do
    addr=$(adb mdns services 2>/dev/null | awk -v n="$name" '$1 == n && /_adb-tls-pairing/ { print $NF; exit }')
    if [[ -n $addr ]]; then
      echo "Found the phone at $addr, pairing…"
      adb_pair "$addr" "$pass" || return 1
      finish_pairing "${addr%:*}"
      return
    fi
    if read -rsn1 -t 1 key; then
      case $key in
      c | C) pair_manual; return ;;
      q | Q) return 130 ;;
      esac
    fi
  done
  echo "Timed out."
  return 1
}

wifi() {
  local serial ip
  adb start-server &>/dev/null
  serial=$(ready_devices | usb_devices | head -1)
  [[ -n $serial ]] || die "Plug your phone in with USB first."

  ip=$(adb -s "$serial" shell ip -f inet addr show wlan0 2>/dev/null | awk '/inet / { sub(/\/.*/, "", $2); print $2; exit }')
  [[ -n $ip ]] || die "Your phone isn't on Wi-Fi."

  adb -s "$serial" tcpip 5555 &>/dev/null || die "Couldn't switch the phone to Wi-Fi."
  sleep 2
  if adb connect "$ip:5555" | grep -q "connected to"; then
    echo "$ip:5555" >"$TCP_FILE"
    notify "Phone on Wi-Fi" "You can unplug the cable. This lasts until the phone restarts."
  else
    die "Couldn't reach the phone at $ip."
  fi
}

# With no argument, finds the phone nearby or over Tailscale. With a port,
# reaches it over Tailscale at that Wireless debugging port; with an
# address and port, connects there.
connect() {
  local target=${1:-} serial ip
  if [[ -z $target ]]; then
    serial=$(pick_device) || exit 1
  else
    adb start-server &>/dev/null
    if [[ $target =~ ^[0-9]+$ ]]; then
      tailscale_enabled || die "Tailscale isn't installed, or TAILSCALE is off in your phonelink config."
      ip=$(tailnet_address) || die "Couldn't find your phone on Tailscale. Set TAILSCALE_HOST in ~/.config/phonelink/config to its Tailscale name."
      target="$ip:$target"
    fi
    [[ $target =~ ^[A-Za-z0-9._-]+:[0-9]+$ ]] || die "Give a port, or an address and port such as 100.101.102.103:41234."
    adb_connect "$target" || die "Couldn't connect to $target. Check that Wireless debugging is on and shows that port."
    is_tailnet_serial "$target" && echo "${target%:*} ${target##*:}" >"$TAILNET_FILE"
    serial=$target
  fi

  if is_tailnet_serial "$serial"; then
    notify "Phone" "Connected to $(device_label "$serial") over Tailscale."
  else
    notify "Phone" "Connected to $(device_label "$serial")."
  fi
}

disconnect() {
  local pid serial _
  # End the sound connection, waiting for any change to it in progress, and
  # the window sessions, so neither reconnects. Then close any phone window
  # left, then drop the Wi-Fi links.
  sound_lock
  sound_stop
  sound_unlock
  for pid in $(session_pids); do
    pkill -TERM -P "$pid" 2>/dev/null
    kill -TERM "$pid" 2>/dev/null
  done
  for _ in {1..30}; do
    [[ -n $(session_pids) ]] || break
    sleep 0.1
  done
  for pid in $(pgrep -x scrcpy); do
    tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -q '^SDL_APP_ID=phonelink' && kill "$pid"
  done
  direct_disconnect
  rm -f "$TCP_FILE"
  adb_running || {
    notify "Phone" "Disconnected."
    return
  }
  for serial in $(ready_devices); do
    [[ $serial == *:* || $serial == *_adb-tls-connect* ]] && adb disconnect "$serial" &>/dev/null
  done

  # While Wireless debugging is on, adb reconnects the phone by itself, and
  # only stopping adb prevents that. Android Studio's emulators and USB devices
  # share it, though, so it stays up while any of those are connected.
  if [[ -z $(all_devices | usb_devices) ]]; then
    adb kill-server &>/dev/null
    notify "Phone" "Disconnected. Open a phone app or the mirror to connect again."
  else
    notify "Phone" "Phone windows closed and Wi-Fi links dropped. adb stays running for your USB devices and emulators, so the phone may reconnect while Wireless debugging is on."
  fi
}

status() {
  local ip port f app state path tier
  adb start-server &>/dev/null
  echo "Connected phones:"
  adb devices -l | tail -n +2 | grep . || echo "  none"
  if direct_serial >/dev/null; then
    echo "Direct link: up ($(<"$DIRECT_FILE"))"
  else
    echo "Direct link: down"
  fi
  if [[ -s $TAILNET_FILE ]]; then
    read -r ip port <"$TAILNET_FILE"
    echo "Tailscale: $ip, Wireless debugging port ${port:-unknown}"
  elif tailscale_enabled; then
    echo "Tailscale: not seen yet (connect the phone nearby once)"
  fi
  [[ -s $APPS_CACHE ]] && echo "Cached apps: $(wc -l <"$APPS_CACHE")"
  for f in "$STATE_DIR"/session.*.state; do
    [[ -f $f ]] || continue
    app=${f##*/session.}
    app=${app%.state}
    read -r state path tier <"$f"
    echo "Window $app: $state over $(path_label "$path"), quality step $((tier + 1)) of $((TIER_LAST + 1)) (${TIER_RATES[tier]}bit/s)"
  done
}

usage() {
  sed -n '3p' "$SELF" | sed 's/^# //'
  echo
  grep -E '^#   phonelink' "$SELF" | sed 's/^# //'
}

# Checks for the adb server without starting it: starting it would reconnect
# a phone the user just disconnected.
adb_running() {
  ss -Hltn "sport = :${ANDROID_ADB_SERVER_PORT:-5037}" 2>/dev/null | grep -q .
}

# State for the bar widget, as JSON. --brief skips asking the phone its name.
status_json() {
  local via=none serial="" name="" direct=false supported=false mirror=false relayed=false reconnecting=false
  local nearby classes apps pkg icon f app sound=phone pid
  [[ -n $(p2p_device) ]] && supported=true
  direct_link_up && direct=true

  if adb_running; then
    nearby=$(nearby_devices)
    if serial=$(usb_devices <<<"$nearby" | head -1) && [[ -n $serial ]]; then
      via=usb
    elif serial=$(direct_serial); then
      via=direct
    elif [[ -n $nearby ]]; then
      serial=$(head -1 <<<"$nearby")
      via=wifi
    elif serial=$(tailnet_devices | head -1) && [[ -n $serial ]]; then
      via=tailscale
      # While traffic flows, an empty CurAddr means Tailscale is relaying.
      tailnet_peer "${serial%:*}" | jq -e '.Active and .CurAddr == ""' &>/dev/null && relayed=true
    fi
    [[ $via == none || ${1:-} == --brief ]] || name=$(device_label "$serial")
  fi

  for f in "$STATE_DIR"/session.*.state; do
    [[ -f $f && $(cut -d' ' -f1 "$f") == reconnecting ]] || continue
    app=${f##*/session.}
    session_running "${app%.state}" && reconnecting=true
  done

  classes=$(hyprctl clients -j 2>/dev/null | jq -r '.[].class' | grep '^phonelink' || true)
  grep -qxF phonelink <<<"$classes" && mirror=true

  # Recently opened apps first, then pinned ones, at most eight.
  apps=$(
    {
      cat "$RECENT_FILE" 2>/dev/null
      for f in "$DESKTOP_DIR"/phonelink.*.desktop; do
        pkg=${f##*/phonelink.}
        pkg=${pkg%.desktop}
        is_pinned "$pkg" && echo "$pkg"
      done
    } | awk '!seen[$0]++' | head -8 | while read -r pkg; do
      valid_pkg "$pkg" || continue
      icon="$ICON_DIR/phonelink.$pkg.png"
      [[ -s $icon ]] || icon=""
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$pkg" "$(app_name "$pkg")" "$icon" \
        "$(is_pinned "$pkg" && echo 1)" "$(grep -qxF "phonelink.$pkg" <<<"$classes" && echo 1)" "$(sound_pref "$pkg")"
    done | jq -R -s 'split("\n") | map(select(length > 0) | split("\t")
      | { package: .[0], name: .[1], icon: .[2], pinned: (.[3] == "1"), open: (.[4] == "1"), sound: .[5] })'
  )

  # Read where the sound is between changes, never halfway through one. A
  # sound connection with no phone window left (one that crashed, say) would
  # keep the phone silent, so the bar's regular check ends it. A young one may
  # belong to a window that's still opening.
  if sound_lock 5; then
    pid=$(sound_session_pids | head -1)
    [[ -n $pid ]] || pid=$(sound_pid)
    if [[ -n $pid && -z $(live_window_keys) ]] && (($(ps -o etimes= -p "$pid" 2>/dev/null || echo 0) > 10)); then
      sound_stop
    fi
    sound_here && sound=pc
    sound_unlock
  else
    sound_here && sound=pc
  fi

  jq -n --arg via "$via" --arg name "$name" --argjson direct "$direct" --argjson supported "$supported" \
    --argjson mirror "$mirror" --argjson relayed "$relayed" --argjson reconnecting "$reconnecting" \
    --argjson apps "${apps:-[]}" --arg sound "$sound" --arg mirrorSound "$(sound_pref mirror)" \
    '{ connected: ($via != "none"), via: $via, relayed: $relayed, reconnecting: $reconnecting, name: $name, direct: $direct,
       directSupported: $supported, mirrorOpen: $mirror, sound: $sound, mirrorSound: $mirrorSound, apps: $apps }'
}

# ---------------------------------------------------------------- doctor

# Checks the usual causes of lag and dropouts, and says what to do about each.
doctor() {
  local serial="" path="" wifi link freq signal bssid ps con st rssi tx pfreq pbssid serialno hevc decode k t
  say() { printf '  %s %s\n' "$1" "$2"; }

  echo "Phone"
  adb start-server &>/dev/null
  if serial=$(PHONELINK_QUIET=1 PHONELINK_NO_PROMPT=1 pick_device 2>/dev/null); then
    path=$(path_of "$serial")
    say "✓" "Connected over $(path_label "$path") ($serial)"
  else
    serial=""
    say "!" "No phone connected. Turn on Wireless debugging, or plug the phone in."
  fi

  echo
  echo "This computer's Wi-Fi"
  wifi=$(wifi_iface)
  link=$( [[ -n $wifi ]] && iw dev "$wifi" link 2>/dev/null)
  if [[ $link == Connected* ]]; then
    freq=$(awk '$1 == "freq:" { print int($2); exit }' <<<"$link")
    signal=$(awk '$1 == "signal:" { print $2; exit }' <<<"$link")
    bssid=$(awk '$1 == "Connected" { print $3; exit }' <<<"$link")
    if ((freq < 3000)); then
      say "!" "On 2.4 GHz, which is slower and more crowded. Use your router's 5 GHz network if it has one."
    else
      say "✓" "On 5 GHz or above ($freq MHz)"
    fi
    if ((signal < -70)); then
      say "!" "Weak signal ($signal dBm). Moving closer to the router helps."
    else
      say "✓" "Signal $signal dBm"
    fi
    ps=$(iw dev "$wifi" get power_save 2>/dev/null | awk '{ print $NF }')
    if [[ $ps == on ]]; then
      con=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$wifi" '$2 == d { print $1; exit }')
      say "!" "Wi-Fi power saving is on, a common cause of lag spikes. To turn it off:"
      echo "      nmcli connection modify \"$con\" 802-11-wireless.powersave 2 && nmcli connection up \"$con\""
    else
      say "✓" "Wi-Fi power saving is off"
    fi
  else
    say "✓" "Not on Wi-Fi"
  fi

  if [[ -n $serial && $path != usb ]]; then
    echo
    echo "The phone's Wi-Fi"
    st=$(adb -s "$serial" shell cmd wifi status 2>/dev/null | tr -d '\r')
    if grep -q "Wifi is connected" <<<"$st"; then
      rssi=$(grep -oE 'RSSI: -?[0-9]+' <<<"$st" | head -1 | grep -oE -- '-?[0-9]+$')
      tx=$(grep -oE 'Calculated Tx *: *[0-9]+' <<<"$st" | head -1 | grep -oE '[0-9]+$')
      pfreq=$(grep -oE 'Frequency: [0-9]+' <<<"$st" | head -1 | grep -oE '[0-9]+$')
      pbssid=$(grep -oE 'BSSID: [0-9a-fA-F:]{17}' <<<"$st" | head -1 | awk '{ print $2 }')
      if [[ -n $rssi ]]; then
        if ((rssi < -70)); then say "!" "Weak signal ($rssi dBm), which slows its uplink."; else say "✓" "Signal $rssi dBm"; fi
      fi
      if [[ -n $tx ]]; then
        if ((tx < 25)); then
          say "!" "Its Wi-Fi uplink carries about $tx Mbit/s, so phonelink keeps the video light."
        else
          say "✓" "Uplink about $tx Mbit/s"
        fi
      fi
      [[ -n $pfreq ]] && ((pfreq < 3000)) && say "!" "On 2.4 GHz. Its 5 GHz network would be faster."
      if [[ $path != tailscale && -n $pbssid && -n ${bssid:-} && ${pbssid,,} != "${bssid,,}" ]]; then
        say "!" "The phone and this computer use different access points, so video crosses between them. Fine over a wired mesh, slower over a wireless one."
      fi
    else
      say "!" "The phone isn't on Wi-Fi. Android turns Wireless debugging off without it."
    fi
  fi

  echo
  echo "Direct Wi-Fi link"
  if [[ -z $(p2p_device) ]]; then
    say "✓" "Not available here (it needs NetworkManager with wpa_supplicant)"
  elif direct_link_up; then
    if direct_mcc; then
      say "!" "Up, but on another channel than your Wi-Fi, so the two share the radio. phonelink uses the router while that lasts."
    else
      say "✓" "Up, on the same channel as your Wi-Fi"
    fi
  else
    say "✓" "Down. It's set up when a window opens over Wi-Fi."
  fi

  if [[ $path == tailscale ]]; then
    echo
    echo "Tailscale"
    if tailnet_relayed "${serial%:*}"; then
      say "!" "Relayed through Tailscale's servers, which adds lag. A direct connection needs UDP to get through on both networks."
    else
      say "✓" "Direct connection"
    fi
  fi

  echo
  echo "Video"
  if [[ -n $serial ]]; then
    serialno=$(adb -s "$serial" shell getprop ro.serialno 2>/dev/null | tr -cd 'A-Za-z0-9')
    hevc=$(cat "$STATE_DIR/hevc.$serialno" 2>/dev/null)
    case $hevc in
    yes) say "✓" "The phone has a hardware H.265 encoder, used to keep slow links sharp" ;;
    no) say "✓" "No hardware H.265 encoder on the phone, so H.264 throughout" ;;
    *) say "✓" "The phone's encoders get checked when the next window opens" ;;
    esac
  fi
  decode=$(grep -h "Video decoding:" "$LOG_DIR"/*.log 2>/dev/null | tail -1 | awk '{ print $NF }')
  case $decode in
  "") ;;
  software) say "!" "This computer decodes the video in software. Installing your GPU's VA-API driver (libva-mesa-driver, intel-media-driver or nvidia-vaapi-driver) takes the load off the CPU." ;;
  *) say "✓" "This computer decodes the video in hardware ($decode)" ;;
  esac
  if grep -qs "INJECT_EVENTS" "$LOG_DIR"/*.log; then
    say "!" "The phone blocked mouse and keyboard input before. Samsung: turn off Settings › Security and privacy › Auto Blocker."
  fi

  if [[ -s $QUALITY_FILE ]]; then
    echo
    echo "Quality learned per network"
    while read -r k t; do
      [[ $t =~ ^[0-9]+$ ]] && ((t <= TIER_LAST)) || continue
      say "✓" "${k/:/ on }: step $((t + 1)) of $((TIER_LAST + 1)) (${TIER_RATES[t]}bit/s)"
    done <"$QUALITY_FILE"
  fi
}

# ---------------------------------------------------------------- main

main() {
  local cmd=${1:-menu} serial
  shift || true

  case $cmd in
  __session) session "$@" ;;
  __run) run_plain "$@" ;;
  __sound) sound_session "$@" ;;
  menu) omarchy-menu summon phone ;;
  apps) require_tools; choose_app ;;
  open) require_tools; open_app "${1:?Usage: phonelink open <package>}" ;;
  mirror) require_tools; mirror ;;
  pin) require_tools; pin_menu ;;
  pair) require_tools; pair ;;
  connect) require_tools; connect "${1:-}" ;;
  direct) require_tools; direct "${1:-on}" ;;
  sound) require_tools; sound_cmd "${1:-toggle}" "${2:-}" ;;
  wifi) require_tools; wifi ;;
  stop | disconnect) require_tools; disconnect ;;
  doctor) require_tools; doctor ;;
  refresh)
    require_tools
    serial=$(pick_device) || exit 1
    refresh_apps "$serial"
    echo "Apps: $(wc -l <"$APPS_CACHE")"
    notify "Phone" "Found $(wc -l <"$APPS_CACHE") apps on your phone."
    ;;
  status)
    if [[ ${1:-} == --json ]]; then
      status_json "${2:-}"
    else
      require_tools
      status
    fi
    ;;
  -h | --help | help) usage ;;
  *) usage; exit 1 ;;
  esac
}

# On one line, so a window session that runs for hours never reads on into a
# newer copy of this file installed meanwhile.
main "$@"; exit $?
