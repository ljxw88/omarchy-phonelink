  // >>> phonelink >>> Android phone (built on scrcpy). Updated by its installer.
  "phone": {"icon":"󰄜","label":"Phone","aliases":["phonelink","android"],"description":"Use your Android phone"},
  "phone.apps": {"icon":"󰀻","label":"Open phone app","action":"phonelink apps"},
  "phone.mirror": {"icon":"󰍹","label":"Mirror screen","action":"phonelink mirror"},
  "phone.sound": {"icon":"󰽟","label":"Switch sound","description":"Play the phone window's sound on this computer or the phone","action":"phonelink sound toggle"},
  "phone.pin": {"icon":"󰐃","label":"Pin apps to launcher","action":"phonelink pin"},
  "phone.refresh": {"icon":"󰑐","label":"Refresh app list","action":"phonelink refresh"},
  "phone.network": {"icon":"󰛳","label":"Network map","description":"How this computer reaches your phone, and where each address comes from","action":"phonelink network --panel"},
  "phone.doctor": {"icon":"󰓙","label":"Check connection","description":"Find common causes of lag and dropouts","action":"omarchy-launch-floating-terminal-with-presentation phonelink doctor"},
  "phone.stop": {"icon":"󰅙","label":"Disconnect","description":"Close phone windows and drop all connections","action":"phonelink stop"},
  "phone.wireless": {"icon":"󰖩","label":"Wi-Fi"},
  "phone.wireless.direct": {"icon":"󱄙","label":"Direct link (faster)","description":"Wi-Fi Direct straight to the phone, skipping the router","when":"nmcli -t -f TYPE device 2>/dev/null | grep -qx wifi-p2p","checked":"nmcli -t -f NAME connection show --active | grep -qx phonelink-direct","action":"phonelink direct toggle"},
  "phone.wireless.connect": {"icon":"󰌘","label":"Connect","description":"Find your phone nearby or over Tailscale","action":"phonelink connect"},
  "phone.wireless.pair": {"icon":"󰐲","label":"Pair with QR code","description":"Android 11+, same Wi-Fi network","action":"phonelink pair"},
  "phone.wireless.usb": {"icon":"󰕓","label":"Switch USB phone to Wi-Fi","action":"phonelink wifi"},
  // <<< phonelink <<<
