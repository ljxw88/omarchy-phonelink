  // >>> phonelink >>> Android phone (built on scrcpy). Updated by its installer.
  "phone": {"icon":"󰄜","label":"Phone","aliases":["phonelink","android"]},
  "phone.apps": {"icon":"󰀻","label":"Apps","action":"phonelink apps"},
  "phone.mirror": {"icon":"󰦉","label":"Mirror","action":"phonelink mirror"},
  "phone.sound": {"icon":"󰽟","label":"Sound","action":"phonelink sound toggle"},
  "phone.pin": {"icon":"󰐃","label":"Pin apps","action":"phonelink pin"},
  "phone.refresh": {"icon":"󰑐","label":"Refresh apps","action":"phonelink refresh"},
  "phone.network": {"icon":"󰛳","label":"Network","action":"phonelink network --panel"},
  "phone.doctor": {"icon":"󰓙","label":"Check connection","action":"omarchy-launch-floating-terminal-with-presentation phonelink doctor"},
  "phone.stop": {"icon":"󰐥","label":"Disconnect","action":"phonelink stop"},
  "phone.wireless": {"icon":"󰖩","label":"Connection"},
  "phone.wireless.direct": {"icon":"󱚸","label":"Direct link","when":"nmcli -t -f TYPE device 2>/dev/null | grep -qx wifi-p2p","checked":"nmcli -t -f NAME connection show --active | grep -qx phonelink-direct","action":"phonelink direct toggle"},
  "phone.wireless.connect": {"icon":"󰌘","label":"Connect","action":"phonelink connect"},
  "phone.wireless.pair": {"icon":"󰐲","label":"Pair","action":"phonelink pair"},
  "phone.wireless.usb": {"icon":"󰕓","label":"USB to Wi-Fi","action":"phonelink wifi"},
