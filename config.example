# phonelink settings (bash). Uncomment to change a default.

# Use one specific phone when several are connected (see `phonelink status`).
# SERIAL="R5CT1234567"

# Over Wi-Fi, link straight to the phone with Wi-Fi Direct (auto), or always go
# through the router (off). The phone must be unlocked the first time each session.
# DIRECT="auto"

# uhid: the phone sees a real keyboard (shortcuts, layouts, and the phone's own
# keyboard app for languages like Chinese). sdk: types text, ASCII only.
# KEYBOARD="uhid"

# Density of single-app windows. Higher = bigger text and buttons.
# APP_DPI=200

# Where a phone window's sound plays until you switch it (Super + Alt + V, or
# the speaker button in the bar panel): "pc" or "phone". Your switch is
# remembered for each app and the mirror.
# SOUND="pc"

# App icons for the dock, launcher and bar come from each app's Google Play
# page, which tells Google the app's package name. "off" uses a generic icon.
# APP_ICONS="play"

# Video quality follows the connection by itself (auto). "off" uses scrcpy's
# defaults plus your options below.
# ADAPT="auto"
# How long a window that lost its connection keeps trying to come back, in
# seconds. 0 closes it instead.
# RECONNECT_SECS=120

# Extra scrcpy options (see `scrcpy --help`). They override the automatic
# quality, so a fixed bit rate here turns the adapting off for it:
# COMMON_ARGS=(--video-bit-rate=8M)
# Show the phone keyboard and IME candidates inside app windows instead of on the phone:
# APP_ARGS=(--no-vd-system-decorations --keep-active --display-ime-policy=local)
# Mirror resolution cap, in pixels on the long side. Lower is snappier over Wi-Fi.
# Add --turn-screen-off to keep the phone's own screen dark while mirroring:
# MIRROR_ARGS=(--max-size=1600)

# Away from home, reach the phone over Tailscale when both are on the same
# tailnet (auto), or never (off).
# TAILSCALE="auto"
# The phone's Tailscale name, if phonelink can't work it out (for example with
# several Android devices on the tailnet):
# TAILSCALE_HOST="my-phone"
# Extra scrcpy options over Tailscale only:
# REMOTE_ARGS=(--max-size=1280)
